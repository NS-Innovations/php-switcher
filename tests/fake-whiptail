#!/usr/bin/env bash
#
# fake-whiptail - stands in for whiptail in the menu tests
#
# Every call is logged to $FAKE_WHIPTAIL_LOG as "=== <box>: <title>"; text boxes also log the file
# they show. Message and text boxes return OK on their own. Every other box takes the next line of
# $FAKE_WHIPTAIL_QUEUE, "<exit code><TAB><answer>", prints the answer (\n becomes a newline) where
# whiptail prints a selection, and exits with that code.
#
# SPDX-License-Identifier: MIT

set -o nounset

#find the box type, its title and its text or file
	kind=''
	title=''
	text=''
	args=("$@")
	for ((i = 0; i < ${#args[@]}; i++)); do
		case "${args[$i]}" in
			--title) title=${args[$((i + 1))]} ;;
			--menu|--radiolist|--checklist|--inputbox|--yesno|--msgbox|--textbox) kind=${args[$i]#--}; text=${args[$((i + 1))]} ;;
		esac
	done

#log the call
	{
		echo "=== $kind: ${title%%  (*}"
		if [ "$kind" = textbox ]; then cat "$text"; fi
	} >> "${FAKE_WHIPTAIL_LOG:?}"

#boxes that only show something
	case "$kind" in
		msgbox|textbox) exit 0 ;;
	esac

#everything else answers from the queue
	line=$(head -n 1 "${FAKE_WHIPTAIL_QUEUE:?}" 2>/dev/null || true)
	if [ -z "$line" ]; then
		echo "!!! queue empty at $kind: $title" >> "$FAKE_WHIPTAIL_LOG"
		exit 255
	fi
	sed -i 1d "$FAKE_WHIPTAIL_QUEUE"
	rc=${line%%$'\t'*}
	answer=${line#*$'\t'}
	if [ "$kind" != yesno ]; then printf '%b' "$answer" >&2; fi
	exit "$rc"
